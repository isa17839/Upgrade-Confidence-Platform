<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Upgrade Confidence Platform - New Functionality Draft</title>
  <meta name="description" content="Draft introduction page for new Upgrade Confidence Platform functionality." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --slds-g-spacing-1: 0.25rem;
      --slds-g-spacing-2: 0.5rem;
      --slds-g-spacing-3: 0.75rem;
      --slds-g-spacing-4: 1rem;
      --slds-g-spacing-5: 1.5rem;
      --slds-g-spacing-6: 2rem;
      --slds-g-radius-border-2: 0.25rem;
      --slds-g-color-brand-base-60: #1b96ff;
      --slds-g-color-brand-base-50: #0176d3;
      --slds-g-color-surface-1: #fff;
      --slds-g-color-surface-2: #f3f3f3;
      --slds-g-color-on-surface-1: #747474;
      --slds-g-color-on-surface-2: #2e2e2e;
      --slds-g-color-on-surface-3: #181818;
      --slds-g-font-family: system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica Neue, Arial, sans-serif;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      font-family: var(--slds-g-font-family);
      background: var(--slds-g-color-surface-2);
      color: var(--slds-g-color-on-surface-3);
      min-height: 100%;
    }

    .slds-global-header {
      background: var(--slds-g-color-brand-base-60);
      color: #fff;
      padding: var(--slds-g-spacing-3) var(--slds-g-spacing-6);
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 1.1rem;
      font-weight: 600;
      letter-spacing: 0.01em;
    }

    .slds-context-bar {
      background: var(--slds-g-color-surface-1);
      border-bottom: 1px solid var(--slds-g-color-on-surface-1);
      padding: var(--slds-g-spacing-2) var(--slds-g-spacing-6);
      display: flex;
      align-items: center;
      gap: var(--slds-g-spacing-4);
    }

    .slds-context-bar__label {
      font-size: 1.05rem;
      color: var(--slds-g-color-on-surface-2);
      font-weight: 500;
    }

    .slds-main-content {
      max-width: 1100px;
      margin: var(--slds-g-spacing-6) auto;
      background: var(--slds-g-color-surface-1);
      border-radius: var(--slds-g-radius-border-2);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      padding: var(--slds-g-spacing-6);
      position: relative;
    }

    .badge {
      font-size: 0.75rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--slds-g-color-brand-base-50);
      border: 1px solid var(--slds-g-color-brand-base-60);
      background: rgba(255, 255, 255, 0.7);
      border-radius: 999px;
      padding: 6px 10px;
      margin-left: var(--slds-g-spacing-3);
    }

    .current-version-info {
      position: absolute;
      top: 24px;
      right: 24px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      background: var(--slds-g-color-surface-1);
      border-radius: var(--slds-g-radius-border-2);
      border: 1px solid var(--slds-g-color-on-surface-1);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      padding: 10px 16px;
      z-index: 2;
    }

    .current-version-info .info-row {
      display: flex;
      gap: 24px;
      justify-content: flex-end;
    }

    .current-version-info .tile {
      margin: 0;
      padding: 0;
      border: 0;
      background: transparent;
      box-shadow: none;
      display: flex;
      align-items: baseline;
      gap: 6px;
    }

    .current-version-info .tile-label {
      font-size: 0.8rem;
      text-transform: uppercase;
      color: var(--slds-g-color-on-surface-1);
      margin: 0;
    }

    .current-version-info .tile-value {
      margin: 0;
      font-size: 1rem;
      font-weight: 700;
      color: var(--slds-g-color-brand-base-50);
    }

    .section {
      margin-top: var(--slds-g-spacing-5);
      background: var(--slds-g-color-surface-2);
      border-radius: var(--slds-g-radius-border-2);
      border: 1px solid var(--slds-g-color-on-surface-1);
      padding: var(--slds-g-spacing-4);
    }

    .section h2 {
      margin: 0 0 var(--slds-g-spacing-2);
      font-size: 1.3rem;
      color: var(--slds-g-color-on-surface-2);
    }

    .section--spotlight {
      background: linear-gradient(135deg, #fff7db 0%, #ffffff 45%, #e8f4ff 100%);
      border: 2px solid #f5c542;
      box-shadow: 0 10px 22px rgba(245, 197, 66, 0.25);
      position: relative;
      overflow: hidden;
    }

    .section--spotlight::before {
      content: "Customer Value Highlight";
      position: absolute;
      top: 0;
      right: 0;
      background: #f5c542;
      color: #2f2100;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      padding: 6px 10px;
      border-bottom-left-radius: var(--slds-g-radius-border-2);
    }

    .spotlight-title {
      font-size: 1.55rem;
      color: #1d3f72;
      margin-bottom: var(--slds-g-spacing-2);
    }

    .spotlight-intro {
      font-size: 1.02rem;
      max-width: 80ch;
      color: #2f3a48;
      margin-bottom: var(--slds-g-spacing-3);
    }

    .benefits-list {
      margin: 0;
      padding-left: 1.1rem;
      display: grid;
      gap: 0.45rem;
      line-height: 1.5;
    }

    .benefits-summary {
      border-left: 4px solid var(--slds-g-color-brand-base-60);
      background: #ffffff;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--slds-g-spacing-2);
      margin-top: var(--slds-g-spacing-2);
    }

    .tile {
      border-radius: var(--slds-g-radius-border-2);
      padding: var(--slds-g-spacing-3);
      background: var(--slds-g-color-surface-1);
      border: 1px solid var(--slds-g-color-on-surface-1);
    }

    .tile-label {
      font-size: 0.8rem;
      color: var(--slds-g-color-on-surface-1);
      text-transform: uppercase;
    }

    .tile-value {
      margin-top: var(--slds-g-spacing-1);
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--slds-g-color-brand-base-50);
    }

    .tile-meta {
      margin-top: var(--slds-g-spacing-1);
      font-size: 0.85rem;
      color: var(--slds-g-color-on-surface-1);
      line-height: 1.4;
    }

    .card {
      background: var(--slds-g-color-surface-1);
      border-radius: var(--slds-g-radius-border-2);
      padding: var(--slds-g-spacing-3);
      border: 1px solid var(--slds-g-color-on-surface-1);
    }

    .release-groups {
      display: grid;
      gap: var(--slds-g-spacing-2);
    }

    .release-group {
      border: 1px solid var(--slds-g-color-on-surface-1);
      border-radius: var(--slds-g-radius-border-2);
      background: var(--slds-g-color-surface-1);
      padding: var(--slds-g-spacing-2) var(--slds-g-spacing-3);
    }

    .release-group summary {
      cursor: pointer;
      font-weight: 700;
      color: var(--slds-g-color-brand-base-50);
      list-style: none;
    }

    .release-group summary::-webkit-details-marker {
      display: none;
    }

    .release-group summary::before {
      content: "> ";
      color: var(--slds-g-color-on-surface-1);
    }

    .release-group[open] summary::before {
      content: "v ";
    }

    .release-list {
      margin: var(--slds-g-spacing-2) 0 0;
      padding-left: 1.2rem;
      line-height: 1.6;
    }

    .actions {
      margin-top: var(--slds-g-spacing-4);
      display: flex;
      gap: var(--slds-g-spacing-2);
      flex-wrap: wrap;
    }

    .btn {
      border: 0;
      border-radius: var(--slds-g-radius-border-2);
      padding: 10px 18px;
      font-weight: 600;
      cursor: pointer;
      font-size: 1rem;
    }

    .btn-primary {
      background: var(--slds-g-color-brand-base-60);
      color: #fff;
    }

    .btn-secondary {
      background: var(--slds-g-color-surface-2);
      color: var(--slds-g-color-brand-base-50);
      border: 1px solid var(--slds-g-color-brand-base-60);
    }

    .footer {
      margin-top: var(--slds-g-spacing-4);
      text-align: center;
      font-size: 0.85rem;
      color: var(--slds-g-color-on-surface-1);
    }

    @media (max-width: 900px) {
      .slds-main-content {
        padding: var(--slds-g-spacing-3);
      }

      .grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .current-version-info {
        position: static;
        margin-bottom: 8px;
        justify-content: flex-end;
      }

      .current-version-info .info-row {
        justify-content: flex-end;
      }
    }

    @media (max-width: 600px) {
      .slds-global-header,
      .slds-context-bar {
        flex-direction: column;
        align-items: flex-start;
        padding: var(--slds-g-spacing-2);
      }

      .slds-main-content {
        padding: var(--slds-g-spacing-2);
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .current-version-info {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
      }

      .current-version-info .info-row {
        flex-direction: column;
        gap: 8px;
      }
    }
  </style>
</head>
<body>
  <div class="slds-global-header">
    <span>Upgrade Confidence Platform</span>
    <span class="badge">Draft Presentation Page</span>
  </div>
  <nav class="slds-context-bar">
    <span class="slds-context-bar__label">Product Updates</span>
  </nav>
  <main class="slds-main-content">
    <!-- Upgrade Confidence Platform: Feature Blocks -->
    <div class="current-version-info">
      <div class="info-row">
        <div class="tile">
          <span class="tile-label">Installed Version:</span>
          <span class="tile-value">v121.4</span>
        </div>
        <div class="tile">
          <span class="tile-label">Install Date:</span>
          <span class="tile-value">2025-11-10</span>
        </div>
      </div>
      <div class="info-row">
        <div class="tile">
          <span class="tile-label">Target Version:</span>
          <span class="tile-value">v121.14</span>
        </div>
        <div class="tile">
          <span class="tile-label">Release Date:</span>
          <span class="tile-value">2026-05-15</span>
        </div>
      </div>
    </div>
    <section class="section" id="version-lifecycle" style="margin-top: 0;">
      <h2>Version Lifecycle Status</h2>
      <p>Supported → Maintenance → Deprecated → EOL timeline</p>
      <div class="grid">
        <div class="tile">
          <div class="tile-label">v121.14</div>
          <div class="tile-value">Supported</div>
          <div class="tile-meta">Maintenance starts: 2026-11-10</div>
        </div>
        <div class="tile">
          <div class="tile-label">v120.4</div>
          <div class="tile-value">Maintenance</div>
          <div class="tile-meta">Deprecated on: 2026-08-15</div>
        </div>
        <div class="tile">
          <div class="tile-label">v118.10</div>
          <div class="tile-value">Deprecated</div>
          <div class="tile-meta">EOL on: 2026-12-01</div>
        </div>
      </div>
    </section>

    <section class="section section--spotlight" id="upgrade-benefits">
      <h2 class="spotlight-title">Upgrade Benefits</h2>
      <p class="spotlight-intro">AI-generated summary of cumulative improvements designed to highlight customer-visible value, risk reduction, and operational gains.</p>
      <div class="card benefits-summary">
        <p><strong>AI Summary:</strong> Upgrading to v121.14 provides faster performance, stronger security controls, smarter automation behavior, and clearer operational insights. Teams can ship with higher confidence while reducing manual triage effort.</p>
        <ul class="benefits-list">
          <li>Higher release confidence through improved risk scoring and diagnostics.</li>
          <li>Reduced admin workload with better metadata impact explanations.</li>
          <li>Faster issue resolution via guided recommendations and AI assistance.</li>
          <li>Improved end-user experience through layout and flow reliability updates.</li>
          <li>Better auditability with richer simulation and QA reporting outputs.</li>
        </ul>
      </div>
    </section>

    <section class="section" id="aggregated-changelogs">
      <h2>Aggregated Change Logs</h2>
      <p>Combined release notes from all versions between current and target (e.g., v121.4 → v121.14)</p>
      <div class="card">
        <div class="release-groups">
          <details class="release-group" open>
            <summary>v121.14 - 20 Release Notes</summary>
            <ul class="release-list">
              <li>Added AI-powered upgrade impact summary panel.</li>
              <li>Introduced confidence score trend visualization.</li>
              <li>Optimized metadata diff processing for large orgs.</li>
              <li>Improved permission set comparison accuracy.</li>
              <li>Added inline recommendations for high-risk items.</li>
              <li>Expanded test execution report details.</li>
              <li>Improved scratch org creation retry handling.</li>
              <li>Added release lifecycle badge mapping.</li>
              <li>Enhanced component loading performance by 18%.</li>
              <li>Improved chat assistant context retention.</li>
              <li>Added support for grouped changelog aggregation.</li>
              <li>Improved flow impact detection for subflows.</li>
              <li>Added UI indicators for deprecated metadata use.</li>
              <li>Enhanced API error messaging for tooling calls.</li>
              <li>Added export-to-CSV for simulation findings.</li>
              <li>Improved regression detection sensitivity settings.</li>
              <li>Updated confidence scoring weights defaults.</li>
              <li>Hardened auth token refresh during long jobs.</li>
              <li>Added quick filters for impacted business areas.</li>
              <li>Fixed edge case in managed package version parsing.</li>
            </ul>
          </details>

          <details class="release-group">
            <summary>v121.12 - 20 Release Notes</summary>
            <ul class="release-list">
              <li>Added metadata category severity labels.</li>
              <li>Improved Apex class dependency graphing.</li>
              <li>Enhanced layout change summaries for admins.</li>
              <li>Added permission regression warning rules.</li>
              <li>Improved aggregated release note deduplication.</li>
              <li>Reduced simulation startup time by 12%.</li>
              <li>Added pipeline-safe report artifact naming.</li>
              <li>Improved error surface for failed test suites.</li>
              <li>Added support for extended release date metadata.</li>
              <li>Refined flow change impact categorization.</li>
              <li>Improved report download stability in long sessions.</li>
              <li>Added confidence score tooltip explanations.</li>
              <li>Enhanced changelog search by keyword.</li>
              <li>Added baseline comparison against previous upgrade.</li>
              <li>Improved managed package boundary detection.</li>
              <li>Added business-friendly wording presets.</li>
              <li>Improved QA summary table rendering.</li>
              <li>Added API fallback for transient packaging errors.</li>
              <li>Fixed inconsistent date formatting in reports.</li>
              <li>Patched null-reference issue in impact viewer.</li>
            </ul>
          </details>

          <details class="release-group">
            <summary>v121.10 - 20 Release Notes</summary>
            <ul class="release-list">
              <li>Shipped security patch for permission set sync.</li>
              <li>Added pre-upgrade dependency validation checks.</li>
              <li>Improved flow trigger sequence simulation.</li>
              <li>Added score penalties for untested Apex paths.</li>
              <li>Improved dashboard load times on medium orgs.</li>
              <li>Added changelog merge support for patch releases.</li>
              <li>Enhanced lifecycle timeline rendering.</li>
              <li>Added warning when coverage drops below threshold.</li>
              <li>Improved packaging org API pagination handling.</li>
              <li>Added metadata impact export to JSON.</li>
              <li>Improved chat assistant response grounding.</li>
              <li>Added deployment step timing breakdown.</li>
              <li>Improved layout field-level diff visibility.</li>
              <li>Added release note source trace links.</li>
              <li>Improved retry logic for flaky sandbox tests.</li>
              <li>Added clearer status labels for simulation phases.</li>
              <li>Improved apex test failure grouping by class.</li>
              <li>Added support for batch changelog ingestion.</li>
              <li>Fixed scorecard rounding inconsistency.</li>
              <li>Patched stale cache issue in metadata summaries.</li>
            </ul>
          </details>

          <details class="release-group">
            <summary>v121.8 - 20 Release Notes</summary>
            <ul class="release-list">
              <li>Introduced enhanced test coverage reporting.</li>
              <li>Added first version of AI confidence scorecard.</li>
              <li>Improved changelog readability for admin users.</li>
              <li>Added lifecycle status mapping for versions.</li>
              <li>Improved simulation logs with step-by-step output.</li>
              <li>Added metadata category normalization rules.</li>
              <li>Improved permission diff matching performance.</li>
              <li>Added initial pre-upgrade checklist generator.</li>
              <li>Improved package install date extraction logic.</li>
              <li>Added QA regressions summary counters.</li>
              <li>Improved release note parser resiliency.</li>
              <li>Added warning banners for deprecated dependencies.</li>
              <li>Improved flow element-level impact detection.</li>
              <li>Added report section anchors for quick navigation.</li>
              <li>Improved tooltips for risk categories.</li>
              <li>Added fallback behavior for missing release notes.</li>
              <li>Improved layout comparison for dynamic forms.</li>
              <li>Added basic assistant Q and A templates.</li>
              <li>Fixed duplicate entry bug in aggregated notes.</li>
              <li>Patched minor UI spacing issues in result cards.</li>
            </ul>
          </details>
        </div>
      </div>
    </section>

    <section class="section" id="metadata-impact-viewer">
      <h2>Metadata Impact Viewer</h2>
      <p>Changed metadata categories with importance levels and business-friendly descriptions.</p>
      <div class="grid">
        <div class="tile">
          <div class="tile-label">Apex Classes</div>
          <div class="tile-value">High</div>
          <p>Core logic changes affecting automation and integrations.</p>
        </div>
        <div class="tile">
          <div class="tile-label">Flows</div>
          <div class="tile-value">Medium</div>
          <p>Updates to business process automations.</p>
        </div>
        <div class="tile">
          <div class="tile-label">Layouts</div>
          <div class="tile-value">Low</div>
          <p>Minor UI adjustments for end users.</p>
        </div>
      </div>
    </section>

    <section class="section" id="ai-confidence-score">
      <h2>AI Confidence Score</h2>
      <p>Risk assessment with scoring breakdown (Apex, Flows, Permissions, Layouts)</p>
      <div class="grid">
        <div class="tile">
          <div class="tile-label">Apex</div>
          <div class="tile-value">92%</div>
        </div>
        <div class="tile">
          <div class="tile-label">Flows</div>
          <div class="tile-value">88%</div>
        </div>
        <div class="tile">
          <div class="tile-label">Permissions</div>
          <div class="tile-value">95%</div>
        </div>
        <div class="tile">
          <div class="tile-label">Layouts</div>
          <div class="tile-value">97%</div>
        </div>
      </div>
      <div class="card">
        <p><strong>Overall Confidence:</strong> 93% (Low risk for upgrade)</p>
      </div>
    </section>

    <section class="section" id="ai-chat-assistant">
      <h2>AI Chat Assistant</h2>
      <p>Plain-language Q&A about upgrade impact.</p>
      <div class="card">
        <p><strong>Q:</strong> Will this upgrade affect my custom flows?</p>
        <p><strong>A:</strong> No breaking changes detected in your custom flows. Minor improvements will be applied automatically.</p>
      </div>
    </section>

    <section class="section" id="pre-upgrade-simulation">
      <h2>Pre-Upgrade Simulation</h2>
      <p>Step through a simulated upgrade: create a scratch org, deploy, run unit tests, and show a report. Each button below demonstrates the intended workflow with draft data.</p>
      <div class="actions" id="sim-actions">
        <button class="btn btn-primary" id="btn-create">Create Scratch Org</button>
        <button class="btn btn-primary" id="btn-deploy" disabled>Deploy</button>
        <button class="btn btn-primary" id="btn-tests" disabled>Run Unit Tests</button>
        <button class="btn btn-primary" id="btn-report" disabled>Show Report</button>
      </div>
      <div class="card" id="sim-status" style="min-height: 48px; margin-top: 18px;"></div>
      <script>
        (function() {
          const steps = [
            {
              btn: 'btn-create',
              label: 'Creating scratch org...',
              done: 'Scratch org created successfully!'
            },
            {
              btn: 'btn-deploy',
              label: 'Deploying to scratch org...',
              done: 'Deployment completed with 0 errors.'
            },
            {
              btn: 'btn-tests',
              label: 'Running unit tests...',
              done: 'All 128 unit tests passed. Coverage: 94%.'
            },
            {
              btn: 'btn-report',
              label: 'Generating upgrade simulation report...',
              done: 'Report ready: <a href="#" style="color:#1b96ff;text-decoration:underline;">Download Simulation Report (PDF)</a>'
            }
          ];
          let current = 0;
          const status = document.getElementById('sim-status');
          function setButtonState(idx, enabled) {
            document.getElementById(steps[idx].btn).disabled = !enabled;
          }
          function resetAll() {
            for (let i = 0; i < steps.length; i++) setButtonState(i, i === 0);
            current = 0;
            status.innerHTML = '';
          }
          steps.forEach((step, idx) => {
            document.getElementById(step.btn).addEventListener('click', function() {
              status.innerHTML = `<span style="color:#0176d3;font-weight:500;">${step.label}</span> <span class="sim-loader" style="display:inline-block;width:18px;height:18px;vertical-align:middle;"><svg width="18" height="18" viewBox="0 0 50 50"><circle cx="25" cy="25" r="20" fill="none" stroke="#f5c542" stroke-width="5" stroke-linecap="round" stroke-dasharray="31.4 31.4" transform="rotate(-90 25 25)"><animateTransform attributeName="transform" type="rotate" from="0 25 25" to="360 25 25" dur="0.7s" repeatCount="indefinite"/></circle></svg></span>`;
              for (let j = idx + 1; j < steps.length; j++) setButtonState(j, false);
              setTimeout(() => {
                status.innerHTML = `<span style="color:#1d3f72;font-weight:600;">${step.done}</span>`;
                if (idx + 1 < steps.length) setButtonState(idx + 1, true);
              }, 1200 + Math.random() * 600);
            });
          });
          // Reset on page load
          resetAll();
        })();
      </script>
    </section>

    <section class="section" id="upgrade-actions">
      <h2>Upgrade Actions</h2>
      <p>Start upgrade, download report, run simulation</p>
      <div class="actions" id="upgrade-actions-bar">
        <button class="btn btn-primary" id="btn-upgrade">Start Upgrade</button>
        <button class="btn btn-secondary" id="btn-download">Download Report</button>
        <button class="btn btn-secondary" id="btn-run-sim">Run Simulation</button>
      </div>
      <div class="card" id="upgrade-actions-status" style="min-height: 44px; margin-top: 16px;"></div>
      <script>
        (function() {
          const status = document.getElementById('upgrade-actions-status');
          document.getElementById('btn-upgrade').addEventListener('click', function() {
            status.innerHTML = `<span style='color:#0176d3;font-weight:500;'>Starting upgrade...</span> <span class='sim-loader' style='display:inline-block;width:18px;height:18px;vertical-align:middle;'><svg width='18' height='18' viewBox='0 0 50 50'><circle cx='25' cy='25' r='20' fill='none' stroke='#f5c542' stroke-width='5' stroke-linecap='round' stroke-dasharray='31.4 31.4' transform='rotate(-90 25 25)'><animateTransform attributeName='transform' type='rotate' from='0 25 25' to='360 25 25' dur='0.7s' repeatCount='indefinite'/></circle></svg></span>`;
            setTimeout(() => {
              status.innerHTML = `<span style='color:#1d3f72;font-weight:600;'>Upgrade completed successfully! <span style='color:#27ae60;'>✔</span></span>`;
            }, 1400 + Math.random() * 600);
          });
          document.getElementById('btn-download').addEventListener('click', function() {
            status.innerHTML = `<span style='color:#0176d3;font-weight:500;'>Preparing report for download...</span> <span class='sim-loader' style='display:inline-block;width:18px;height:18px;vertical-align:middle;'><svg width='18' height='18' viewBox='0 0 50 50'><circle cx='25' cy='25' r='20' fill='none' stroke='#f5c542' stroke-width='5' stroke-linecap='round' stroke-dasharray='31.4 31.4' transform='rotate(-90 25 25)'><animateTransform attributeName='transform' type='rotate' from='0 25 25' to='360 25 25' dur='0.7s' repeatCount='indefinite'/></circle></svg></span>`;
            setTimeout(() => {
              status.innerHTML = `<span style='color:#1d3f72;font-weight:600;'>Report ready: <a href='#' style='color:#1b96ff;text-decoration:underline;'>Download Upgrade Report (PDF)</a></span>`;
            }, 1100 + Math.random() * 600);
          });
          document.getElementById('btn-run-sim').addEventListener('click', function() {
            status.innerHTML = `<span style='color:#0176d3;font-weight:500;'>Running upgrade simulation...</span> <span class='sim-loader' style='display:inline-block;width:18px;height:18px;vertical-align:middle;'><svg width='18' height='18' viewBox='0 0 50 50'><circle cx='25' cy='25' r='20' fill='none' stroke='#f5c542' stroke-width='5' stroke-linecap='round' stroke-dasharray='31.4 31.4' transform='rotate(-90 25 25)'><animateTransform attributeName='transform' type='rotate' from='0 25 25' to='360 25 25' dur='0.7s' repeatCount='indefinite'/></circle></svg></span>`;
            setTimeout(() => {
              status.innerHTML = `<span style='color:#1d3f72;font-weight:600;'>Simulation complete. <span style='color:#27ae60;'>No errors detected.</span></span>`;
            }, 1300 + Math.random() * 600);
          });
        })();
      </script>
    </section>

    <section class="section" id="qa-results">
      <h2>QA Results</h2>
      <p>Automated test results (tests passed, coverage, regressions)</p>
      <div class="grid">
        <div class="tile">
          <div class="tile-label">Tests Passed</div>
          <div class="tile-value">128</div>
        </div>
        <div class="tile">
          <div class="tile-label">Coverage</div>
          <div class="tile-value">94%</div>
        </div>
        <div class="tile">
          <div class="tile-label">Regressions</div>
          <div class="tile-value">0</div>
        </div>
      </div>
    </section>
    <p class="footer">Draft only. Replace sample data and copy with production-aligned values before external sharing.</p>
  </main>
</body>
</html>
